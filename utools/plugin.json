{
  "pluginName": "算有所得",
  "version": "0.1.5",
  "description": "算有所得 FunCalc：变量、矩阵、LaTeX 排版与历史记录",
  "author": "farfarfun",
  "main": "dist/index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "pluginSetting": { "height": 620 },
  "features": [
    {
      "code": "funcalc",
      "explain": "打开计算笔记本与历史记录",
      "platform": ["darwin", "win32", "linux"],
      "cmds": ["算有所得", "FunCalc", "计算笔记", "历史计算器", "矩阵计算"]
    },
    {
      "code": "calculate-selection",
      "explain": "在算有所得中计算选中的表达式",
      "cmds": [{ "type": "over", "label": "计算表达式", "minLength": 1, "maxLength": 500 }]
    }
  ],
  "tools": {
    "calculate_expression": {
      "description": "用 FunCalc 的 40 位精度计算一次表达式，返回结果和 LaTeX；不读取或修改计算笔记本的变量与历史。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": { "type": "string", "description": "要计算的表达式，最多 500 个字符", "maxLength": 500 }
        },
        "required": ["expression"]
      }
    }
  }
}
